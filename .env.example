# =============================================================================
# Portfolio Chatbot Backend: Environment Variables Template
# =============================================================================
# Copy this file to .env and populate the required keys.
# NEVER commit the .env file to Git.
# =============================================================================

# Pinecone Vector Database
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=portfolio-chatbot

# Groq LLM & Fallback Cascade
GROQ_API_KEY=your-groq-api-key
GROQ_CASCADE_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-120b,qwen/qwen3.6-27b,openai/gpt-oss-20b,llama-3.1-8b-instant

# Embedding (Pinecone Cloud Inference)
# Multilingual (FR/EN) model hosted and computed directly by Pinecone (dimension 1024)
EMBEDDING_MODEL=multilingual-e5-large

# CORS Configuration
# Allowed origin URLs separated by commas
ALLOWED_ORIGINS=https://romainsebire.fr

# Security & Administration
RATE_LIMIT_PER_MINUTE=10
MAX_DAILY_TOKENS_PER_IP=50000
MAX_MESSAGE_LENGTH=250
ADMIN_KEY=your-secret-admin-key
BLOCKED_IPS=123.45.67.89,98.76.54.32

# Logging
LOG_LEVEL=INFO
