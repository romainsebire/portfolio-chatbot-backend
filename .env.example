# =============================================================================
# Portfolio Chatbot Backend — Variables d'environnement
# =============================================================================
# Copier ce fichier en .env et remplir les valeurs.
# Ne JAMAIS commiter le fichier .env.
# =============================================================================

# --- Pinecone (Base vectorielle) ---
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=portfolio-chatbot

# --- Groq (LLM) ---
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# --- Embedding ---
# all-MiniLM-L6-v2 (384-dim, ~80MB, rapide, anglais-dominant)
# paraphrase-multilingual-MiniLM-L12-v2 (384-dim, ~470MB, meilleur en français)
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# --- CORS ---
# Origines autorisées (séparées par des virgules)
ALLOWED_ORIGINS=https://romainsebire.fr

# --- Sécurité ---
RATE_LIMIT_PER_MINUTE=10
MAX_MESSAGE_LENGTH=500

# --- Logging ---
LOG_LEVEL=INFO
